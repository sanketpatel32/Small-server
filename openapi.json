            },
            "description": "Matching \"small-server-v1\" or * produces 304."
          }
        ],
        "responses": {
          "200": {
            "description": "Cached response (HEAD has no body)",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string",
                  "const": "\"small-server-v1\""
                }
              },
              "Cache-Control": {
