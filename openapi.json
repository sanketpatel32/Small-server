    "/lab/echo": {
      "get": {
        "tags": [
          "http-lab"
        ],
        "summary": "Echo request details",
        "description": "Returns the request method, path, query values and header values as arrays, raw body text, parsed JSON or null, and body byte count. Authorization, Cookie, and X-API-Key header values are redacted. Request bodies are limited to 1 MiB.",
        "responses": {
          "200": {
            "description": "Echoed request (HEAD has no response body)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 1 MiB"
          }
        }
      },
      "post": {
