{
  "openapi": "3.1.0",
  "info": {
    "title": "Small-Server",
    "version": "1.3.0",
    "description": "A tiny REST API testing server — full CRUD on any JSON payload, SQLite-backed. Built with Go. Includes public HTTP lab endpoints for echo, status, delay, redirect, and cache testing. Only /secure/* routes require X-API-Key authentication."
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "payload": {
            "description": "Whatever JSON you sent, stored verbatim"
          },
          "scope": {
            "type": "string",
            "enum": [
              "public",
              "secure"
            ]
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "Cleared": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "cleared"
          },
          "scope": {
            "type": "string"
          },
          "removed": {
            "type": "integer",
            "description": "count of items deleted"
          }
        }
      },
      "Deleted": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "deleted"
          },
          "id": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "EchoResponse": {
        "type": "object",
        "required": [
          "method",
          "path",
          "query",
          "headers",
          "body",
          "json",
          "bytes"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "headers": {
            "type": "object",
            "description": "Header names map to arrays of values. Authorization, Cookie, and X-API-Key values are redacted.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "body": {
            "type": "string",
            "description": "Raw request body text."
          },
          "json": {
            "description": "Parsed JSON body, or null when the body is not valid JSON."
          },
          "bytes": {
            "type": "integer",
            "description": "Request body size in bytes."
          }
        }
      },
      "LabStatus": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LabDelay": {
        "type": "object",
        "required": [
          "delay_ms",
          "status"
        ],
        "properties": {
          "delay_ms": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "LabCached": {
        "type": "object",
        "required": [
          "message",
          "version"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Cached response"
          },
          "version": {
            "type": "integer",
            "const": 1
          }
        }
      },
      "UploadStatus": {
        "type": "object",
        "required": [
          "configured",
          "max_bytes"
        ],
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "max_bytes": {
            "type": "integer",
            "const": 10485760
          }
        }
      },
      "UploadFile": {
        "type": "object",
        "required": [
          "key",
          "size",
          "etag",
          "last_modified"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "size": {
            "type": "integer"
          },
          "etag": {
            "type": "string"
          },
          "last_modified": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UploadList": {
        "type": "object",
        "required": [
          "files",
          "next_cursor"
        ],
        "properties": {
          "files": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/UploadFile"
            }
          },
          "next_cursor": {
            "type": "string"
          }
        }
      },
      "UploadCreated": {
        "type": "object",
        "required": [
          "key",
          "filename",
          "size",
          "content_type",
          "download_path"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "content_type": {
            "type": "string"
          },
          "download_path": {
            "type": "string",
            "example": "/secure/uploads/0123456789abcdef0123456789abcdef-example.txt"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Lightweight in-memory telemetry (resets on restart)",
        "responses": {
          "200": {
            "description": "stats snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uptime_seconds": {
                      "type": "integer"
                    },
                    "started_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "total_requests": {
                      "type": "integer"
                    },
                    "by_method": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "by_status": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "last_request": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "latency": {
                      "type": "object",
                      "description": "Latency over the last 100 requests",
                      "properties": {
                        "avg_ms": {
                          "type": "number"
                        },
                        "min_ms": {
                          "type": "number"
                        },
                        "max_ms": {
                          "type": "number"
                        },
                        "p95_ms": {
                          "type": "number"
                        },
                        "samples": {
                          "type": "integer"
                        }
                      }
                    },
                    "items_total": {
                      "type": "integer"
                    },
                    "items_public": {
                      "type": "integer"
                    },
                    "items_secure": {
                      "type": "integer"
                    },
                    "db_size_bytes": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/items": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "List all public items",
        "responses": {
          "200": {
            "description": "array of items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "public"
        ],
        "summary": "Create — store ANY JSON payload (no auth)",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "description": "Any valid JSON — object, array, string, number, boolean, or null"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "public"
        ],
        "summary": "Clear all — delete every public item",
        "responses": {
          "200": {
            "description": "cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cleared"
                }
              }
            }
          }
        }
      }
    },
    "/public/items/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Read one public item by id",
        "responses": {
          "200": {
            "description": "item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "public"
        ],
        "summary": "Update — replace the payload of a public item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Any valid JSON — replaces the existing payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "public"
        ],
        "summary": "Delete one public item by id",
        "responses": {
          "200": {
            "description": "deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deleted"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/secure/items": {
      "get": {
        "tags": [
          "secure"
        ],
        "summary": "List all secure items",
        "security": [
          {
            "ApiKeyAuth": []
