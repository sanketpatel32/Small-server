    "/lab/status/{code}": {
      "parameters": [
        {
          "name": "code",
          "in": "path",
          "required": true,
          "description": "HTTP status code to return (200–599).",
          "schema": {
            "type": "integer",
            "minimum": 200,
            "maximum": 599
          }
        }
      ],
      "get": {
        "tags": [
          "http-lab"
        ],
        "summary": "Return a chosen HTTP status",
        "description": "Returns {status,message} for statuses with a body. 204, 205, and 304 have no response body. 429 includes Retry-After: 5.",
        "responses": {
          "200": {
            "description": "Requested response (its actual HTTP status is the path value; HEAD and bodyless statuses have no body)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "The requested status code from 200 through 599; response contains {status,message} except for 204, 205, and 304",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "head": {
        "tags": [
          "http-lab"
        ],
        "summary": "Return a chosen HTTP status",
        "description": "Returns {status,message} for statuses with a body. 204, 205, and 304 have no response body. 429 includes Retry-After: 5.",
        "responses": {
          "200": {
            "description": "Requested response (its actual HTTP status is the path value; HEAD and bodyless statuses have no body)"
          },
          "default": {
            "description": "The requested status code from 200 through 599; response contains {status,message} except for 204, 205, and 304",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/lab/delay/{ms}": {
      "parameters": [
        {
          "name": "ms",
          "in": "path",
          "required": true,
          "description": "Delay in milliseconds (0–10,000).",
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      ],
      "get": {
        "tags": [
          "http-lab"
        ],
        "summary": "Wait, then return a result",
        "description": "Wait is cancellable when the request context is canceled.",
        "responses": {
          "200": {
            "description": "Delay completed (HEAD has no response body)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabDelay"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or out-of-range delay"
          }
        }
      },
      "head": {
        "tags": [
          "http-lab"
        ],
        "summary": "Wait, then return a result",
        "description": "Wait is cancellable when the request context is canceled.",
        "responses": {
          "200": {
            "description": "Delay completed (HEAD has no response body)"
          },
          "400": {
            "description": "Invalid or out-of-range delay"
          }
        }
      }
    },
    "/lab/redirect": {
      "get": {
        "tags": [
          "http-lab"
        ],
        "summary": "Redirect to a local path",
        "parameters": [
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Local absolute path; defaults to /lab/echo. External URLs and paths beginning with // are rejected.",
            "schema": {
              "type": "string",
