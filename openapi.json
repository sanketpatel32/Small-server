        "responses": {
          "200": {
            "description": "cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cleared"
                }
              }
            }
          },
          "401": {
            "description": "missing/invalid API key"
          }
        }
      }
